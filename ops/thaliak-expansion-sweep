#!/usr/bin/env python3
import argparse
import grp
import os
import pwd
import sqlite3
import sys
import uuid

DEFAULT_DB_PATH = "/srv/thaliak/db/thaliak.db"
DEFAULT_ARM_PATH = "/srv/thaliak/control/global-expansion-sweep.arm"


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def require_root():
    if os.geteuid() != 0:
        fail("Run this helper with sudo.")


def arm(path):
    if os.path.exists(path):
        fail("A manual expansion sweep is already armed.")

    print("Warning: the expansion-account login may terminate an active FFXIV game session.")
    confirmation = input("Type ARM to queue one expansion sweep: ").strip()
    if confirmation != "ARM":
        fail("Expansion sweep was not armed.")

    os.makedirs(os.path.dirname(path), mode=0o750, exist_ok=True)
    request_id = uuid.uuid4()
    temporary_path = f"{path}.{request_id.hex}.tmp"
    with open(temporary_path, "x", encoding="ascii") as marker:
        marker.write(f"{request_id}\n")

    account = pwd.getpwnam("thaliak")
    group = grp.getgrnam("thaliak")
    os.chown(temporary_path, account.pw_uid, group.gr_gid)
    os.chmod(temporary_path, 0o600)
    os.replace(temporary_path, path)
    print("One manual Global expansion sweep is armed.")


def cancel(path):
    if not os.path.exists(path):
        print("No manual expansion sweep is armed.")
        return

    os.unlink(path)
    print("Manual expansion sweep cancelled.")


def status(db_path, arm_path):
    print(f"Manual request: {'armed' if os.path.exists(arm_path) else 'not armed'}")
    if not os.path.exists(db_path):
        fail(f"Database not found: {db_path}")

    with sqlite3.connect(db_path) as connection:
        tables = {
            row[0]
            for row in connection.execute("select name from sqlite_master where type = 'table'")
        }
        if "expansion_sweep_attempts" not in tables:
            fail("The expansion-sweep migration has not been applied.")

        rows = connection.execute(
            """
            select a.id, a.trigger, a.status, v.version_string,
                   a.detected_at_utc, a.completed_at_utc,
                   a.max_expansion, a.discovered_patch_count, a.last_error
            from expansion_sweep_attempts a
            join repo_versions v on v.id = a.trigger_repo_version_id
            order by a.id desc
            limit 10
            """
        ).fetchall()

    if not rows:
        print("No expansion sweep attempts recorded.")
        return

    for row in rows:
        attempt_id, trigger, attempt_status, version, detected, completed, max_expansion, count, error = row
        summary = (
            f"{attempt_id}: {trigger} {attempt_status} base={version} "
            f"detected={detected} completed={completed or '-'} "
            f"max_expansion={max_expansion if max_expansion is not None else '-'} "
            f"patches={count if count is not None else '-'}"
        )
        print(summary)
        if error:
            print(f"    error: {error}")


def main():
    parser = argparse.ArgumentParser(description="Manage one-shot Thaliak Global expansion sweeps.")
    parser.add_argument("--db", default=os.environ.get("THALIAK_DB", DEFAULT_DB_PATH))
    parser.add_argument("--arm-path", default=os.environ.get("THALIAK_EXPANSION_ARM", DEFAULT_ARM_PATH))
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("arm")
    subparsers.add_parser("cancel")
    subparsers.add_parser("status")
    args = parser.parse_args()

    require_root()
    if args.command == "arm":
        arm(args.arm_path)
    elif args.command == "cancel":
        cancel(args.arm_path)
    else:
        status(args.db, args.arm_path)


if __name__ == "__main__":
    main()
